license: MIT
repository-code: "https://github.com/AstroCGHA/xcape_remastered"
keywords:
  - CAPE
  - severe weather
  - supercell composite parameter
  - significant tornado parameter
  - effective inflow layer
  - storm-relative helicity
  - streamwise vorticity
  - DCAPE
  - ERA5
  - reanalysis
  - numba
  - dask
  - xarray
